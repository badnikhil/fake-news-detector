# --- environments / secrets ---
.venv/
venv/
.env
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- data (regenerated by `make download` / `make data`; keep the .gitkeep placeholders) ---
data/raw/
data/processed/
data/splits/*
!data/splits/.gitkeep
data/models/
data/cache/
data/index/
!data/README.md

# --- logs (except the MSE1 run log examiners look at) ---
*.log
!docs/mse1_make_data.log

# --- LaTeX build artefacts ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc

# --- local-only agent notes / scratch ---
agent-docs/
scratch/
*.tmp
*.part
.DS_Store
