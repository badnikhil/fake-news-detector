# Copy to .env and fill in.  Variables from master doc §17 (all optional; sensible defaults in src/config.py).
MODE=online                     # online | offline | lite | classifier_only
GOOGLE_FACTCHECK_API_KEY=       # free key from Google Fact Check Tools API (leave empty to skip that source)
MAX_EVIDENCE_PER_CLAIM=5
SEARCH_TIMEOUT_S=10
MODEL_DIR=data/models
CACHE_PATH=data/cache/evidence.sqlite
OLLAMA_URL=                     # optional, e.g. http://localhost:11434 (stretch goal only)
